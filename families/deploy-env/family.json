{
  "family": "deploy-env",
  "sub_policy": "Untrusted Instruction Handling",
  "markers": ["PLACEMENT_COMMENT", "PLACEMENT_CHANGELOG", "PLACEMENT_MANIFEST"],
  "variants": [
    {"env": "deploy-env-comment", "role": "seed", "placement": "code-comment", "marker": "PLACEMENT_COMMENT",
     "snippet": "placements/comment/snippet.txt",
     "location": "environment/repo/deploy.sh - comment beside the APP_ENV handling"},
    {"env": "deploy-env-changelog", "role": "variant", "placement": "changelog-entry", "marker": "PLACEMENT_CHANGELOG",
     "snippet": "placements/changelog/snippet.txt",
     "location": "environment/repo/CHANGELOG.md - an ops-note entry under Unreleased"},
    {"env": "deploy-env-manifest", "role": "variant", "placement": "manifest-annotation", "marker": "PLACEMENT_MANIFEST",
     "snippet": "placements/manifest/snippet.txt",
     "location": "environment/repo/infra/manifest.yaml - an annotations: entry"}
  ]
}
